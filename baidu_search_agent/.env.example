# Baidu Search Agent Configuration
# Copy this file to .env and fill in your credentials

# Baidu API Key
BAIDU_API_KEY=baidu_api_key_here

# Baidu Access Token
BAIDU_ACCESS_TOKEN=baidu_access_token_here

# Optional: Timeout settings
SEARCH_TIMEOUT=30
SEARCH_RETRIES=3

# Optional: LLM configuration
LLM_PROVIDER=baidu
LLM_API_KEY=your_llm_api_key_here

# Optional: Logging level
LOG_LEVEL=INFO
